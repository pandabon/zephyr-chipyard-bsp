CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_HTIF=y
CONFIG_UART_SIFIVE_PORT_0=n
CONFIG_PRINTK=y
CONFIG_EARLY_CONSOLE=y
CONFIG_REBOOT=y

CONFIG_XIP=n
CONFIG_RISCV_PMP=n
CONFIG_PINCTRL=n

CONFIG_FPU=y
CONFIG_FPU_SHARING=y
CONFIG_FLOAT_HARD=y

# SYS_CLOCK_HW_CYCLES_PER_SEC (mtime) and RTC_CLOCK_DIVIDER_VALUE are in
# soc/chipyard/penguin/Kconfig.defconfig. 10000 ticks/s = 100 us = 50 mtime counts per tick
# at 500 kHz.
CONFIG_SYS_CLOCK_TICKS_PER_SEC=10000
CONFIG_TIMING_FUNCTIONS=y

CONFIG_STACK_SENTINEL=y
CONFIG_IDLE_STACK_SIZE=1024
CONFIG_SPEED_OPTIMIZATIONS=y

# SPDX-License-Identifier: Apache-2.0
#
# The make targets of the Chipyard Zephyr BSP. make does no building itself: every
# target prints the command it runs, and `make help` shows the west equivalent.
#
# This file is included, never run directly:
#   * by the BSP's own Makefile (BSP := its checkout, then `include mk/user.mk`);
#   * by the Makefile of an app repo generated by scripts/make_template_repo.sh,
#     which sets APP (its own folder) and DEFAULT_TARGET, then includes
#     `$(BSP)/mk/user.mk`.
# Before including, a Makefile may set: BSP, WS, APP, DEFAULT_TARGET, MODULES_OVERRIDE.
#
# Overridable on the command line or in the environment (make BSP=... WS=...):
#   WS   the west workspace (`west topdir`); builds go to $(WS)/build/<app name>.
#   BSP  the west project named chipyard-bsp; the BSP's own Makefile sets it to its checkout.
#
# Credits:
#  * Target names and variable style (TTY=, BINARY, "make tsi-run/checktsi") are
#    borrowed from Baremetal-IDE's Makefile (https://github.com/ucb-ee194-tapeout/Baremetal-IDE).

SHELL := /bin/bash
DEFAULT_TARGET ?= help
.DEFAULT_GOAL := $(DEFAULT_TARGET)

# ---- where the workspace and the BSP are (not "the parent folder of the BSP") --
ifndef WS
WS  := $(shell west topdir 2>/dev/null)
endif
ifndef BSP
BSP := $(shell west list -f '{abspath}' chipyard-bsp 2>/dev/null | head -1)
endif
# Children (CMake of a template app) find the BSP through this variable.
export CHIPYARD_BSP := $(BSP)

# ---- variables (all can be given on the command line: make build APP=...) -----
BOARD      ?= chipyard_penguin/penguin
APP        ?=
# APP: a dir with CMakeLists.txt, a plain folder of .c/.cpp files, or a sample name
# (samples/<name>, or external/<name> e.g. atlas_upstream).
APP_DIR    := $(if $(APP),$(if $(wildcard $(APP)/.),$(abspath $(APP)),$(if $(wildcard $(BSP)/samples/$(APP)/.),$(BSP)/samples/$(APP),$(if $(wildcard $(BSP)/external/$(APP)/.),$(BSP)/external/$(APP),$(abspath $(APP))))))
APP_NAME   := $(notdir $(APP_DIR))
BUILD      ?= $(WS)/build/$(APP_NAME)
SNIPPET    ?=
EXTRA_CONF ?=
CMAKE_ARGS ?=
ARGS       ?=
JOBS       ?= 8

# plain folder (no CMakeLists.txt) -> the generic app in cmake/plain_app
ifeq ($(wildcard $(APP_DIR)/CMakeLists.txt),)
SRC_DIR    := $(BSP)/cmake/plain_app
PLAIN_ARGS := -DPLAIN_APP_DIR=$(APP_DIR)
else
SRC_DIR    := $(APP_DIR)
endif
CMAKE_FLAGS := $(PLAIN_ARGS) \
  $(if $(MODULES_OVERRIDE),-DZEPHYR_MODULES="$(MODULES_OVERRIDE)") \
  $(if $(EXTRA_CONF),-DEXTRA_CONF_FILE="$(EXTRA_CONF)") $(CMAKE_ARGS)

.PHONY: help build run debug test clean doctor need-env need-app need-spike

help:
	@echo "Chipyard Zephyr BSP: make front door (each target prints the command it runs)"
	@echo
	@echo "  target  what it does                              west / tool equivalent"
	@echo "  build   compile APP for BOARD                     west build -p auto -b BOARD -d BUILD SRC [-- -D..]"
	@echo "  run     build, then run on Spike (exit = program) west build -d BUILD -t run"
	@echo "  debug   build, then gdb on Spike via OpenOCD      west debug -d BUILD   (build with SNIPPET=debug)"
	@echo "  test    the whole BSP suite on Spike              scripts/run_tests.py -j JOBS --board BOARD"
	@echo "          (Spike is optional: without it, run/debug say so and test only builds)"
	@echo "  doctor  check the tools (SDK, west, cmake, optional Spike)  scripts/doctor.sh"
	@echo "  clean   delete APP's build dir                    rm -rf BUILD (only if it is a build dir)"
	@echo
	@echo "Variables (current value):"
	@echo "  APP=<dir|sample name>  sample dir, plain folder of .c/.cpp, or e.g. hello_rvv   [$(APP)]"
	@echo "  BOARD=                 e.g. chipyard_penguin/penguin/vcu118_ta                   [$(BOARD)]"
	@echo "  BUILD=                 build dir                  [default $(WS)/build/<app name>]"
	@echo "  SNIPPET= EXTRA_CONF= CMAKE_ARGS= ARGS=   extra west snippet / Kconfig file / cmake -D / raw west args"
	@echo "  JOBS= (test)   Examples:"
	@echo "    make run APP=hello_rvv"
	@echo "    make run APP=template/app      # (inside the BSP checkout)"
	@echo "    make build APP=~/labs/mine BOARD=chipyard_penguin/penguin/vcu118_ta"
	@echo "    make test ARGS='-f bf16'"
	@echo
	@echo "This BSP builds ELFs and runs them on Spike. To load an ELF onto hardware use a loader"
	@echo "such as uart_tsi; every build prints the ELF path and an example command line."

need-env:
	@command -v west >/dev/null || { echo "error: west not found; install/activate west and the Zephyr SDK (see README.md, or run: make doctor)"; exit 2; }
	@test -d "$(WS)/.west" || { echo "error: no west workspace found (WS='$(WS)'). Run inside a workspace (west init -l ...) or set WS=<dir with .west/>"; exit 2; }
	@test -f "$(BSP)/zephyr/module.yml" || { echo "error: chipyard-bsp not found (BSP='$(BSP)'): is it a west project named chipyard-bsp? or set BSP=<dir>"; exit 2; }

need-app:
	@test -n "$(APP)" || { echo "error: set APP=<dir or sample name> (try: make help)"; exit 2; }
	@test -d "$(APP_DIR)" || { echo "error: APP '$(APP)' is not a directory"; exit 2; }

# Spike is optional: only `run` and `debug` need it, never `build`. (`test` copes by itself:
# scripts/run_tests.py builds everything and says once that nothing could be run.)
need-spike:
	@command -v "$${SPIKE:-spike}" >/dev/null || { echo "error: Spike not found (looked for '$${SPIKE:-spike}'): set SPIKE=/path/to/spike or run setup with --with-spike. The build above did not need it."; exit 2; }

build: need-env need-app
	@echo "==> build $(APP_DIR) ($(if $(PLAIN_ARGS),plain folder via cmake/plain_app,Zephyr app)) for $(BOARD)"
	west build -p auto -b $(BOARD) -d $(BUILD) $(foreach s,$(SNIPPET),-S $(s)) $(ARGS) $(SRC_DIR) -- $(CMAKE_FLAGS)

run: build need-spike
	@echo "==> run on Spike (ISA string is derived from Kconfig)"
	west build -d $(BUILD) -t run

debug: need-env need-app need-spike
	@test -f $(BUILD)/CMakeCache.txt || $(MAKE) --no-print-directory build APP=$(APP) SNIPPET="$(or $(SNIPPET),debug)"
	@echo "==> gdb on Spike via OpenOCD (needs SPIKE_OPENOCD with remote_bitbang, see README.md)"
	west debug -d $(BUILD) $(ARGS)

test: need-env
	@echo "==> whole BSP suite on Spike; ARGS='-f text' filters"
	$(BSP)/scripts/run_tests.py -j $(JOBS) --board $(BOARD) $(ARGS)

# Report what is installed and what is missing, with fixes. Works without a workspace.
doctor:
	@BSP="$(BSP)" WS="$(WS)" $(BSP)/scripts/doctor.sh

clean: need-app
	@test -f $(BUILD)/CMakeCache.txt || { echo "error: $(BUILD) is not a build directory; not deleting"; exit 2; }
	rm -rf $(BUILD)
